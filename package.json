{
  "name": "anyengine-cli",
  "version": "0.1.0",
  "description": "Use Claude in ChatGPT/Codex and GPT in Claude Code with your existing subscriptions.",
  "license": "MIT",
  "homepage": "https://github.com/hristo2612/anyengine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hristo2612/anyengine.git"
  },
  "bugs": {
    "url": "https://github.com/hristo2612/anyengine/issues"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "anyengine": "scripts/anyengine-cli.mjs"
  },
  "files": [
    "dist/src/",
    "scripts/",
    "npm-shrinkwrap.json",
    "test/fixtures/claude-permission-modes.json",
    "test/fixtures/posture-schema.json",
    "test/fixtures/codex-auth-0.160.0.json",
    "test/fixtures/codex-accounts-0.160.0.json",
    "test/fixtures/claude-messages-2.1.289.json",
    "test/fixtures/claude-posture-2.1.289.json",
    "test/fixtures/raine-translation-v0.1.42.json",
    "crates/anyengine-protocol/fixtures/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "vendor/claude-code-proxy/"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "prepack": "npm run build && node scripts/prepare-package.mjs",
    "postpack": "node scripts/prepare-package.mjs --clean",
    "dev": "tsx src/adapter.mts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint --max-diagnostics=100 src test scripts",
    "format": "biome format --write src test scripts",
    "check": "biome check --max-diagnostics=100 src test scripts && node scripts/check-size.mjs && node scripts/check-complexity.mjs && node scripts/check-deps.mjs && node scripts/check-env-docs.mjs",
    "check:fix": "biome check --write src test scripts",
    "check:rust-protocol-fixtures": "node scripts/check-rust-protocol-fixtures.mjs",
    "check:posture-schema": "node scripts/check-posture-schema.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "npm run test:coverage",
    "test:coverage": "npm run build && node scripts/test-hermetic.mjs --coverage",
    "test:hermetic": "node scripts/test-hermetic.mjs",
    "setup:hooks": "sh scripts/setup-hooks.sh",
    "doctor": "node scripts/doctor.mjs",
    "install:lib": "npm run build && node scripts/install-lib.mjs",
    "anyengine": "npm run build && node dist/src/adapter.mjs",
    "workflow": "npm run build && node dist/src/workflow-cli.mjs",
    "workflow:schedule": "npm run workflow -- schedule",
    "smoke:real": "npm run build && node scripts/smoke-real-claude.mjs",
    "probe:capabilities": "npm run build && node scripts/probe-capabilities.mjs",
    "acceptance:local-remote": "npm run build && node scripts/acceptance-local-remote.mjs",
    "acceptance:gui-ssh-localhost": "npm run build && node scripts/acceptance-gui-ssh-localhost.mjs",
    "acceptance:ssh-runtime-matrix": "npm run build && node scripts/acceptance-ssh-runtime-matrix.mjs",
    "probe:codex-cli-remote": "npm run build && node scripts/probe-codex-cli-remote.mjs",
    "start": "node dist/src/adapter.mjs",
    "generate:schema": "codex app-server generate-ts --experimental --out generated/codex-app-server",
    "postinstall": "node scripts/fix-node-pty-permissions.mjs",
    "smoke:anyengine": "npm run build && node scripts/smoke-anyengine.mjs",
    "smoke:native-codex": "npm run build && node scripts/smoke-native-codex.mjs",
    "smoke:grok": "npm run build && node scripts/smoke-grok.mjs",
    "smoke:bridge": "npm run build && node scripts/smoke-bridge.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.201",
    "@xterm/headless": "6.0.0",
    "node-pty": "1.1.0",
    "smol-toml": "1.9.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/node": "^26.1.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=24"
  }
}
